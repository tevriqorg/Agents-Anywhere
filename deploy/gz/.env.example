# Image built by .github/workflows/server-image.yml
AA_IMAGE=ghcr.io/tevriqorg/agents-anywhere-server:main

# Server is bound only to VPS localhost. Tailscale Serve should proxy to this port.
AA_BIND_PORT=5174

# Generate strong random values before first deployment.
POSTGRES_PASSWORD=replace-with-a-long-random-password
AGENT_SERVER_SECRET=replace-with-a-long-random-secret

# Optional. Set this to the HTTPS URL exposed by Tailscale Serve when OAuth is used.
# Example: https://aa-node.example-tailnet.ts.net
AGENT_SERVER_PUBLIC_ORIGIN=

REDIS_MAXMEMORY=256mb
AGENT_SERVER_MIGRATION_LOCK_TIMEOUT=120
